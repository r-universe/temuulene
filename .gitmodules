[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "mongolmaps"]
	path = mongolmaps
	url = https://github.com/temuulene/mongolmaps
	registered = false
[submodule "mongolstats"]
	path = mongolstats
	url = https://github.com/temuulene/mongolstats
